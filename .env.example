# Sin DATABASE_URL la app usa PGlite (Postgres embebido) y guarda los datos en ./.data/pglite
# En producción apuntar a cualquier Postgres (Supabase, Neon, RDS, VPS propio):
# DATABASE_URL=postgres://usuario:clave@host:5432/sumo_tareas

# Zona horaria con la que se calcula "hoy", "vencidas", "esta semana" y las recurrentes.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Secreto para el endpoint /api/cron/recurrentes (cron externo, ej. Vercel Cron).
CRON_SECRET=cambiar-esto

# URL pública de la app (se usa para armar los links de invitación).
APP_URL=http://localhost:3000
